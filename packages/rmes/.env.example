# rmes-mcp -- INSEE - RMES
#
# Every variable this brick reads, with the default it falls back to. Insee is
# the domain the whole family is grouped under; the other two bricks are separate processes
# with their own env file. Copy this file to .env next to the process that runs this brick.
#
# In the compose stack this brick listens on port 8003; the service sets MCP_PORT
# itself, so the default below only applies to a process started by hand.
#
# Generated from bricks.yaml -- run `uv run python scripts/render_bricks.py`.

# Shared by every brick --------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
HEALTH_PROBE_TIMEOUT_SECONDS=5
ALLOWED_HOSTS=["*"]
ALLOWED_ORIGINS=[]
TRUSTED_PROXY_HOSTS=["127.0.0.1"]
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1
LOG_LEVEL=INFO

# This brick -------------------------------------------------------------------------------------
RMES_SPARQL_ENDPOINT_URL=https://rdf.insee.fr/sparql
RMES_GRAPH_BASE_URI=http://rdf.insee.fr/graphes/
RMES_GRAPH_LISTING_TIMEOUT_SECONDS=45.0
RMES_GRAPH_LISTING_MAX_ROWS=1000
RMES_GRAPH_CACHE_TTL_SECONDS=3600.0

# This brick declares no Elasticsearch host: it answers over SPARQL alone and starts with
# no infrastructure behind it.
