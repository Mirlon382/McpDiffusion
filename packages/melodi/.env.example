# melodi-mcp -- INSEE - MELODI
#
# Every variable this brick reads, with the default it falls back to. Insee is
# the domain the whole family is grouped under; the other two bricks are separate processes
# with their own env file. Copy this file to .env next to the process that runs this brick.
#
# In the compose stack this brick listens on port 8002; the service sets MCP_PORT
# itself, so the default below only applies to a process started by hand.
#
# Generated from bricks.yaml -- run `uv run python scripts/render_bricks.py`.

# Shared by every brick --------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
HEALTH_PROBE_TIMEOUT_SECONDS=5
ALLOWED_HOSTS=["*"]
ALLOWED_ORIGINS=[]
TRUSTED_PROXY_HOSTS=["127.0.0.1"]
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1
LOG_LEVEL=INFO
#ES_HOST=http://localhost:9200
ES_TLS_VERIFY=true
ES_REQUEST_TIMEOUT_SECONDS=30
ES_MAX_RETRIES=2

# This brick -------------------------------------------------------------------------------------
ES_INDEX_MELODI_DATASETS=melodi_datasets
ES_INDEX_MELODI_COLUMNS=melodi_columns
MELODI_DATA_BASE_URL=https://api.insee.fr/melodi/data
MELODI_REQUEST_TIMEOUT_SECONDS=30
MELODI_CONNECT_TIMEOUT_SECONDS=10

# ES_HOST has no default on purpose: this brick answers its search tools from the INSEE
# Elasticsearch indices, so it refuses to start without one.
